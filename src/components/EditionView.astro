---
import BaseLayout from '../layouts/BaseLayout.astro';
import StoryCard from './StoryCard.astro';
import type { Edition } from '../data/editions';

interface Props { edition: Edition; editions: Edition[]; }
const { edition, editions } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
const categories = ['All', ...new Set(edition.stories.map((story) => story.category))];
---

<BaseLayout title={`${edition.dateLabel} | AI News Brief`} description={edition.dek}>
	<div id="top">
		<header class="site-header">
			<a class="brand" href={base} aria-label="AI News Brief home"><span class="brand-mark" aria-hidden="true">✦</span><span>AI NEWS BRIEF</span></a>
			<nav class="nav-links" id="primary-nav" aria-label="Primary navigation"><a href={`${base}#today`}>Today</a><a href="#archive">Archive</a><a href="#about">About</a></nav>
			<div class="header-actions"><span class="edition-status"><span></span> Daily archive</span><button class="menu-button" type="button" aria-label="Toggle navigation" aria-expanded="false" aria-controls="primary-nav"><svg class="menu-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"></path></svg><svg class="close-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"></path></svg></button></div>
		</header>

		<main>
			<section class="dashboard-head shell">
				<div><p class="overline">DAILY EDITION · {edition.dayLabel.toUpperCase()}</p><h1>The AI news<br />worth your attention.</h1></div>
				<div class="edition-card"><div><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"></rect><path d="M8 3v4M16 3v4M3 10h18"></path></svg><span>{edition.dateLabel}</span></div><p>{edition.dek}</p><span class="reading-time"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"></path></svg>{edition.readingTime}</span></div>
			</section>

			<section id="archive" class="archive shell" aria-labelledby="archive-title">
				<div><p class="overline">EDITION ARCHIVE</p><h2 id="archive-title">Browse every brief.</h2></div>
				<label><span>Choose an edition</span><select id="edition-select">
					{editions.map((item) => <option value={item.slug === editions[0].slug ? base : `${base}editions/${item.slug}/`} selected={item.slug === edition.slug}>{item.dateLabel}</option>)}
				</select></label>
				<details class="archive-links"><summary>View all editions</summary><div>{editions.map((item) => <a href={`${base}editions/${item.slug}/`} aria-current={item.slug === edition.slug ? 'page' : undefined}>{item.dateLabel}</a>)}</div></details>
			</section>

			<section id="today" class="news-shell shell">
				<div class="filter-bar"><fieldset class="filters" aria-label="Filter stories by category">{categories.map((category) => <button type="button" class:list={{ active: category === 'All' }} data-filter={category} aria-pressed={category === 'All'}>{category}</button>)}</fieldset><span class="result-count" aria-live="polite">{edition.stories.length} {edition.stories.length === 1 ? 'story' : 'stories'}</span></div>
				<div class="story-list">{edition.stories.map((story, index) => <StoryCard story={story} index={index} />)}</div>
			</section>

			<section id="about" class="about shell"><p class="overline">ABOUT THIS ARCHIVE</p><div><h2>Small, sourced, and designed for scanning.</h2><p>Each dated edition preserves selected developments from the Daily AI Brief, links to its source material, and separates the reported update from a short explanation of why it matters.</p></div></section>
		</main>
		<footer class="shell"><a class="brand" href="#top"><span class="brand-mark" aria-hidden="true">✦</span><span>AI NEWS BRIEF</span></a><p>Current signals. Clear context.</p><span>{editions.length} editions · 2026</span></footer>
	</div>
</BaseLayout>

<script>
	const storageKey = 'ai-brief-saved';
	const filterButtons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
	const storyElements = document.querySelectorAll<HTMLElement>('[data-story]');
	const saveButtons = document.querySelectorAll<HTMLButtonElement>('[data-save]');
	const resultCount = document.querySelector<HTMLElement>('.result-count');
	const menuButton = document.querySelector<HTMLButtonElement>('.menu-button');
	const navigation = document.querySelector<HTMLElement>('.nav-links');
	const editionSelect = document.querySelector<HTMLSelectElement>('#edition-select');
	let saved: string[] = [];
	try {
		const stored = JSON.parse(localStorage.getItem(storageKey) ?? '[]');
		if (Array.isArray(stored)) saved = stored.filter((id) => typeof id === 'string');
	} catch { /* Storage can be unavailable; all controls still work in memory. */ }

	function updateSavedButtons() {
		for (const button of saveButtons) {
			const id = button.dataset.save ?? '';
			const isSaved = saved.includes(id);
			button.classList.toggle('saved', isSaved);
			button.setAttribute('aria-pressed', String(isSaved));
			const title = button.closest('[data-story]')?.querySelector('h2')?.textContent?.trim() ?? 'story';
			button.setAttribute('aria-label', `${isSaved ? 'Remove' : 'Save'} ${title}${isSaved ? ' from saved stories' : ''}`);
		}
	}

	for (const button of saveButtons) button.addEventListener('click', () => {
		const id = button.dataset.save ?? '';
		saved = saved.includes(id) ? saved.filter((item) => item !== id) : [...saved, id];
		try { localStorage.setItem(storageKey, JSON.stringify(saved)); } catch { /* Keep this session's bookmarks usable. */ }
		updateSavedButtons();
	});
	for (const button of filterButtons) button.addEventListener('click', () => {
		const category = button.dataset.filter ?? 'All'; let count = 0;
		for (const candidate of filterButtons) {
			candidate.classList.toggle('active', candidate === button);
			candidate.setAttribute('aria-pressed', String(candidate === button));
		}
		for (const story of storyElements) { const visible = category === 'All' || story.dataset.category === category; story.hidden = !visible; if (visible) count += 1; }
		if (resultCount) resultCount.textContent = `${count} ${count === 1 ? 'story' : 'stories'}`;
	});
	menuButton?.addEventListener('click', () => { const open = navigation?.classList.toggle('is-open') ?? false; menuButton.classList.toggle('is-open', open); menuButton.setAttribute('aria-expanded', String(open)); });
	for (const link of navigation?.querySelectorAll('a') ?? []) link.addEventListener('click', () => { navigation?.classList.remove('is-open'); menuButton?.classList.remove('is-open'); menuButton?.setAttribute('aria-expanded', 'false'); });
	editionSelect?.addEventListener('change', () => { window.location.href = editionSelect.value; });
	updateSavedButtons();
</script>
